<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLauncher"
    android:background="#1a1a2e"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="top"
        android:background="@drawable/launcher_gradient_bg"
        android:layout_width="match_parent"
        android:layout_height="280dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="48dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:id="@+id/tvTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#b0bec5"
                android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"/>
            <ImageButton
                android:id="@+id/btnConnectionStatus"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="2dp"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_connection_status"
                android:contentDescription="Connection status"
                android:layout_marginEnd="12dp"/>
            <ImageButton
                android:id="@+id/btnInfo"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:contentDescription="Device info"
                android:layout_marginEnd="12dp"/>
            <ImageButton
                android:id="@+id/btnClearRecents"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_clear_recents"
                android:contentDescription="Clear recent apps"
                android:layout_marginEnd="12dp"/>
            <ImageButton
                android:id="@+id/btnWifi"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_qs_wifi"
                android:contentDescription="Connect to Wi-Fi"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="56sp"
                android:textColor="#ffffff"
                android:id="@+id/tvClockLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#90caf9"
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:id="@+id/tvStudentName"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#b0bec5"
                android:id="@+id/tvStudentId"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp">
            <View
                android:background="#2962ff"
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#90caf9"
                android:id="@+id/tvInstitutionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Z7i Institution"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"/>
            <View
                android:background="#2962ff"
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <!-- Original: RecyclerView + GridLayoutManager(4). Same grid without AndroidX. -->
        <GridView
            android:id="@+id/rvApps"
            android:numColumns="4"
            android:stretchMode="columnWidth"
            android:horizontalSpacing="0dp"
            android:verticalSpacing="0dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#546e7a"
            android:gravity="center"
            android:id="@+id/tvFooter"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.1"/>
    </LinearLayout>
    <View
        android:layout_gravity="end|bottom"
        android:id="@+id/vBrightnessTouch"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/llBrightnessIndicator"
        android:background="@drawable/launcher_gradient_bg"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="8dp">
        <TextView
            android:textSize="48sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️"/>
        <TextView
            android:textSize="24sp"
            android:textColor="#ffffff"
            android:id="@+id/tvBrightnessPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</FrameLayout>
