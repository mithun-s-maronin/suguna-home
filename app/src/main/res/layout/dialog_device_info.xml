<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Device Info"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#90a4ae"
            android:id="@+id/tvDialogClose"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"/>
    </LinearLayout>
    <View
        android:background="#2a2a3e"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="#22263a"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="#90caf9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Device ID"
                    android:textAllCaps="true"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#ffffff"
                        android:id="@+id/tvDeviceId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:layout_marginEnd="12dp"/>
                    <Button
                        android:textSize="12sp"
                        android:textColor="#ffffff"
                        android:id="@+id/btnVerifyDevice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="96dp"
                        android:text="Verify"
                        android:fontFamily="sans-serif-medium"
                        android:backgroundTint="#2962ff"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#4caf50"
                        android:id="@+id/tvVerifiedBadge"
                        android:background="@drawable/bg_verified_badge"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Verified"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="#22263a"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#90caf9"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Storage"
                        android:layout_weight="1"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#b0bec5"
                        android:id="@+id/tvStoragePercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/pbStorage"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginBottom="6dp"
                    android:progressTint="#2962ff"
                    android:progressBackgroundTint="#37474f"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#90a4ae"
                        android:id="@+id/tvStorageUsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#546e7a"
                        android:id="@+id/tvStorageFree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="#22263a"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#90caf9"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="RAM"
                        android:layout_weight="1"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#b0bec5"
                        android:id="@+id/tvRamPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/pbRam"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginBottom="6dp"
                    android:progressTint="#00bcd4"
                    android:progressBackgroundTint="#37474f"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#90a4ae"
                        android:id="@+id/tvRamUsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#546e7a"
                        android:id="@+id/tvRamFree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="#90caf9"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Allowed Apps"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#546e7a"
                    android:id="@+id/tvAppsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llAppsList"
                android:background="#22263a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>
    </ScrollView>
    <View
        android:background="#2a2a3e"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <Button
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:id="@+id/btnUpdateApps"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="Update Apps"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1565c0"/>
            <Button
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:id="@+id/btnUpdateMdm"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="Update MDM"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="6dp"
                android:backgroundTint="#2962ff"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:id="@+id/btnClearDownloads"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="Clear Downloads"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#37474f"/>
            <Button
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:id="@+id/btnClearData"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="Clear App Data"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="6dp"
                android:backgroundTint="#b71c1c"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
