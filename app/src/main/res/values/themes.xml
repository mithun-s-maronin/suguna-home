<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Setup screen -->
    <style name="Theme.SugunaHome" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/navy</item>
        <item name="android:colorPrimaryDark">@color/navy</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:windowBackground">@color/page_bg</item>
    </style>

    <!-- Home screen: same values as the original Theme.MdmLauncher -->
    <style name="Theme.MdmLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#1a1a2e</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">#1a1a2e</item>
        <item name="android:navigationBarColor">#1a1a2e</item>
    </style>
</resources>
